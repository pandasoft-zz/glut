{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/pandasoft-zz/glut/schema/glut.schema.json",
  "title": "GLUT metadata document",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "setup": {
      "$ref": "#/definitions/setup"
    },
    "assert": {
      "$ref": "#/definitions/assert"
    }
  },
  "definitions": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "default_branch": {
          "type": "string",
          "description": "Sets CI_DEFAULT_BRANCH. Overrides auto-detection from the source repository. Use this when your project uses a non-standard default branch name or when you need a specific value in the test."
        },
        "tag": {
          "type": "string"
        },
        "tag_message": {
          "type": "string",
          "description": "Sets CI_COMMIT_TAG_MESSAGE. Only used when setup.tag is set."
        },
        "pipeline_source": {
          "type": "string",
          "enum": [
            "push",
            "web",
            "merge_request_event",
            "schedule",
            "trigger",
            "api",
            "parent_pipeline",
            "chat"
          ]
        },
        "merge_request": {
          "$ref": "#/definitions/merge_request"
        },
        "upstream": {
          "$ref": "#/definitions/upstream"
        },
        "schedule": {
          "$ref": "#/definitions/schedule"
        },
        "chat": {
          "$ref": "#/definitions/chat"
        },
        "git": {
          "$ref": "#/definitions/git"
        },
        "pipeline": {
          "$ref": "#/definitions/pipeline"
        },
        "api": {
          "$ref": "#/definitions/api"
        },
        "mocks": {
          "$ref": "#/definitions/mocks"
        },
        "components": {
          "$ref": "#/definitions/components"
        },
        "docker": {
          "type": "boolean",
          "default": true,
          "description": "Controls Docker executor behaviour. Omit (default) or set true: jobs with image: run in Docker; jobs without image: run in the shell. Set false: all jobs run in the shell regardless of image: (--force-shell-executor). Use true when your pipeline requires a specific runtime image. Use false to force shell for all jobs."
        },
        "privileged": {
          "type": "boolean",
          "default": false,
          "description": "Run all job containers with the Docker --privileged flag. Only applies when docker: true. Required for images that create user namespaces (e.g. moby/buildkit:rootless for building container images). Security: privileged containers have full host access — use only in test environments."
        },
        "ref_protected": {
          "type": "boolean",
          "description": "Sets CI_COMMIT_REF_PROTECTED. Default false. Set true to simulate a pipeline running on a protected branch."
        }
      },
      "not": {
        "required": [
          "branch",
          "tag"
        ]
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "description": "Controls how `include: component:` directives are resolved.",
      "properties": {
        "fetch": {
          "type": "string",
          "enum": [
            "real"
          ],
          "description": "Set to \"real\" for an integration test: `include: component:` is fetched from a REAL GitLab over HTTPS using the real CI_JOB_TOKEN, so a composite component runs end-to-end with its real sub-components. Requires running inside GitLab CI (or GLUT_COMPONENTS_TOKEN). Real server/namespace come from the host environment (CI_SERVER_HOST / CI_PROJECT_NAMESPACE) or GLUT_COMPONENTS_SERVER / GLUT_COMPONENTS_NAMESPACE. Only the component fetch becomes real; the runtime GitLab API stays mocked. Omit for the default isolated behaviour."
        }
      }
    },
    "merge_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "target_branch": {
          "type": "string"
        },
        "iid": {
          "type": "integer"
        },
        "draft": {
          "type": "boolean"
        },
        "labels": {
          "type": "string"
        },
        "assignees": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Sets CI_MERGE_REQUEST_DESCRIPTION."
        },
        "milestone": {
          "type": "string",
          "description": "Sets CI_MERGE_REQUEST_MILESTONE."
        },
        "squash": {
          "type": "boolean",
          "description": "Sets CI_MERGE_REQUEST_SQUASH. Default false."
        },
        "approved": {
          "type": "boolean",
          "description": "Sets CI_MERGE_REQUEST_APPROVED. Default false."
        },
        "event_type": {
          "type": "string",
          "enum": ["detached", "merged_result", "merge_train"],
          "description": "Sets CI_MERGE_REQUEST_EVENT_TYPE. Default detached."
        },
        "diff_base_sha": {
          "type": "string",
          "description": "Sets CI_MERGE_REQUEST_DIFF_BASE_SHA. Default 0000…0."
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline_id": {
          "type": "integer"
        },
        "project_id": {
          "type": "integer"
        },
        "job_id": {
          "type": "integer"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/definitions/git_user"
        },
        "origin": {
          "$ref": "#/definitions/git_origin"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/definitions/pipeline_user"
        }
      }
    },
    "pipeline_user": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulated GitLab pipeline trigger user. Sets GITLAB_USER_NAME, GITLAB_USER_EMAIL, and GITLAB_USER_LOGIN. When absent, these variables are derived from setup.git.user.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sets GITLAB_USER_NAME. Overrides setup.git.user.name."
        },
        "email": {
          "type": "string",
          "description": "Sets GITLAB_USER_EMAIL. Overrides setup.git.user.email."
        },
        "login": {
          "type": "string",
          "description": "Sets GITLAB_USER_LOGIN."
        }
      }
    },
    "git_user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "git_origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "commands": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/definitions/token"
        },
        "project": {
          "$ref": "#/definitions/project"
        },
        "seed": {
          "$ref": "#/definitions/api_seed"
        },
        "user": {
          "$ref": "#/definitions/api_user"
        },
        "group": {
          "$ref": "#/definitions/api_group"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string"
        },
        "scopes": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_branch": {
          "type": "string",
          "description": "Deprecated: use setup.default_branch instead. Sets CI_DEFAULT_BRANCH and the default_branch field in mock API project responses."
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "Human-readable project name. Sets CI_PROJECT_TITLE and the name field in mock API project responses. Defaults to the last segment of the project path."
        },
        "access_level": {
          "description": "Member access level in permissions.project_access. Accepts string (guest, reporter, developer, maintainer, owner) or integer (10, 20, 30, 40, 50). Defaults to maintainer (40).",
          "oneOf": [
            {
              "type": "string",
              "enum": ["guest", "reporter", "developer", "maintainer", "owner"]
            },
            {
              "type": "integer",
              "enum": [10, 20, 30, 40, 50]
            }
          ]
        }
      }
    },
    "api_seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "releases": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "merge_requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Pre-populate project CI/CD variables. Each object must contain at least 'key' and 'value'."
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Pre-populate repository tags (GET /repository/tags)."
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Pre-populate repository branches (GET /repository/branches)."
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pipelines": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Pre-populate mock pipeline list. Each object is returned verbatim with richer defaults merged in."
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Pre-populate mock job list. Use pipeline_id to associate jobs with a specific pipeline."
        }
      }
    },
    "api_user": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulated GitLab user returned by GET /api/v4/user and /api/v4/users/:id.",
      "properties": {
        "id": {
          "type": "integer",
          "description": "User ID. Default 1."
        },
        "name": {
          "type": "string",
          "description": "Display name. Default 'Test User'."
        },
        "email": {
          "type": "string",
          "description": "Email address. Default 'test@example.com'."
        },
        "login": {
          "type": "string",
          "description": "Username (username field). Default 'test-user'."
        }
      }
    },
    "api_group": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulated GitLab group returned by GET /api/v4/groups/:id.",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Group ID. Default 1."
        },
        "path": {
          "type": "string",
          "description": "Full group path (e.g. 'platform/infra'). Default 'test-group'."
        },
        "name": {
          "type": "string",
          "description": "Display name. Default 'Test Group'."
        }
      }
    },
    "mocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binaries": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/binary_mock"
          }
        }
      }
    },
    "binary_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string"
        }
      }
    },
    "assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/job_assert"
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/artifact_assert"
          }
        },
        "git": {
          "$ref": "#/definitions/git_assert"
        },
        "api": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/api_call_assert"
          }
        },
        "binary": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/binary_assert"
          }
        }
      }
    },
    "job_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit-status": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "present": {
          "type": "boolean"
        },
        "when": {
          "type": "string",
          "enum": ["on_success", "on_failure", "manual", "delayed", "always"]
        },
        "stdout": {
          "$ref": "#/definitions/text_or_matcher"
        },
        "stderr": {
          "$ref": "#/definitions/text_or_matcher"
        },
        "output": {
          "$ref": "#/definitions/text_or_matcher"
        }
      }
    },
    "artifact_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "contents": {
          "$ref": "#/definitions/text_or_matcher"
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "size": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "md5": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "filetype": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink",
            "socket"
          ]
        },
        "report": {
          "$ref": "#/definitions/report_assert"
        }
      }
    },
    "report_assert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "description": "Report format: junit, dotenv, coverage (Cobertura), gitlab-security",
          "enum": ["junit", "dotenv", "coverage", "gitlab-security"]
        },
        "tests": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Total number of test cases (junit)"
        },
        "failures": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of failed test cases (junit)"
        },
        "errors": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of errored test cases (junit)"
        },
        "skipped": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of skipped test cases (junit)"
        },
        "suites": {
          "type": "array",
          "description": "Per-suite assertions (junit)",
          "items": {
            "$ref": "#/definitions/suite_assert"
          }
        },
        "line-rate": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Line coverage rate 0.0–1.0 (coverage/Cobertura)"
        },
        "branch-rate": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Branch coverage rate 0.0–1.0 (coverage/Cobertura)"
        },
        "keys": {
          "type": "object",
          "description": "Key assertions for dotenv format; value is a string/pattern or {exists: bool}",
          "additionalProperties": true
        },
        "critical": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of critical-severity vulnerabilities (gitlab-security)"
        },
        "high": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of high-severity vulnerabilities (gitlab-security)"
        },
        "medium": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of medium-severity vulnerabilities (gitlab-security)"
        },
        "low": {
          "$ref": "#/definitions/value_or_matcher",
          "description": "Number of low-severity vulnerabilities (gitlab-security)"
        }
      }
    },
    "suite_assert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Test suite name as it appears in the JUnit XML"
        },
        "tests": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "failures": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "errors": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "skipped": {
          "$ref": "#/definitions/value_or_matcher"
        }
      }
    },
    "git_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/definitions/git_repo_assert"
        },
        "workspace": {
          "$ref": "#/definitions/git_repo_assert"
        }
      }
    },
    "git_repo_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commits": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "last-commit": {
          "$ref": "#/definitions/git_last_commit_assert"
        },
        "file": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/artifact_assert"
          }
        },
        "branch": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "clean": {
          "type": "boolean"
        }
      }
    },
    "git_last_commit_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author-name": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "author-email": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "message": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "sha": {
          "$ref": "#/definitions/value_or_matcher"
        }
      }
    },
    "api_call_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "called": {
          "type": "boolean"
        },
        "times": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "body": {
          "$ref": "#/definitions/api_body_assert"
        }
      }
    },
    "api_body_assert": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/value_or_matcher"
      },
      "properties": {
        "gjson": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/value_or_matcher"
          }
        }
      }
    },
    "binary_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "called": {
          "type": "boolean"
        },
        "times": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binary_call_assert"
          }
        },
        "never-called-with": {
          "$ref": "#/definitions/binary_call_assert"
        }
      }
    },
    "binary_call_assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "cwd": {
          "$ref": "#/definitions/value_or_matcher"
        },
        "stdin": {
          "$ref": "#/definitions/value_or_matcher"
        }
      }
    },
    "text_or_matcher": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/definitions/value_or_matcher"
        }
      ]
    },
    "value_or_matcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value_or_matcher"
          }
        },
        {
          "$ref": "#/definitions/matcher_object"
        }
      ]
    },
    "matcher_object": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equal"
          ],
          "properties": {
            "equal": {
              "$ref": "#/definitions/value_or_matcher"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "have-prefix"
          ],
          "properties": {
            "have-prefix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "have-suffix"
          ],
          "properties": {
            "have-suffix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contain-substring"
          ],
          "properties": {
            "contain-substring": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "match-regexp"
          ],
          "properties": {
            "match-regexp": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gt"
          ],
          "properties": {
            "gt": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ge"
          ],
          "properties": {
            "ge": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lt"
          ],
          "properties": {
            "lt": {
              "type": "number"
            }
          }
        },
        {
